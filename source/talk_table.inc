LN(CR, I_LD_WIN, -2, 2, 0, "[Hm.] [Patience wins.]"),
LN(SQ, I_LD_WIN, -2, 2, 0, "[I WON? I won! Me! The real me!|Victory!] [I'm going to do my winner voice all week.]"),
