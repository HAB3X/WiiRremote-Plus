/*
   talk_table.inc - what the dealers say when they sit down and PLAY together (Liar's Dice and
   Texas Hold'em): bids, calls, bluffs caught, jabs at each other and the replies.
   {tgt} = who they're talking to, {q} {f} = a bid (four fives), {cnt} = how many there really were,
   {amt} = chips, {hnd} = a hand.  TG_ bits pick lines meant for one person.
   Included in talk_lines.inc. WiiRremote Plus by Habex. GPL-3.0.
*/
#define T_MO (TG_MOTH << W_MOTH)
#define T_LY (TG_MOTH << W_LYNX)
#define T_CR (TG_MOTH << W_CROW)
#define T_SQ (TG_MOTH << W_SQUID)
#define T_VX (TG_MOTH << W_VIXEN)
#define T_VP (TG_MOTH << W_VIPER)
#define T_YOU TG_YOU

/* ================================================================= */
/* LIAR'S DICE                                                        */
/* ================================================================= */
/* sitting down */
LN(MO, I_LD_HELLO, -2, 2, 0, "[The Back Room.|Ah. Dice.] [My favourite game. Everyone lies, and I get to watch.|Nobody can hide a lie from me here. Well. Nobody can hide anything from me anywhere.]"),
LN(MO, I_LD_HELLO, -2, 2, T_YOU, "[Come to the Back Room{A}?|Dice, is it?] [Good. I like watching people lie.|Sit. The cups are waiting.]"),
LN(MO, I_LD_HELLO, -2, 2, T_VP, "[Viper. Off your throne for once.|Slumming it with us, Viper?]"),
LN(LY, I_LD_HELLO, -2, 2, 0, "[Dice night!|Well alright.] [Shake 'em up, folks.|Nothin' beats a good liar's table.]"),
LN(LY, I_LD_HELLO, -2, 2, T_CR, "[Evenin', big fella.|Crow! You playin' tonight?] [Try not to crush the cup this time.]"),
LN(CR, I_LD_HELLO, -2, 2, 0, "[Dice.|Hm. Cups.] [A good game. Honest people lose it.|I will be quiet. Quiet players win.]"),
LN(SQ, I_LD_HELLO, -2, 2, 0, "[Ooh, liar's dice!|Lying game! My favourite!] [Finally, a game where I'm allowed to be someone else.|I promise nothing I say tonight will be true.]"),
LN(VX, I_LD_HELLO, -2, 2, 0, "[Deal me in.|Fine.] [Don't talk too much. It gives you away.]"),
LN(VP, I_LD_HELLO, -2, 2, 0, "[Dice. With the staff.|Very well.] [Let's see who's worth promoting.|I'll try not to take all your chips at once.]"),
LN(VP, I_LD_HELLO, -2, 2, T_MO, "[The Moth sits down.|Old man.] [Try not to read my mind. There's nothing in there for you.|Careful. I play to win.]"),
LN(AN, I_LD_HELLO, -2, 2, 0, "[Evening.|Right then.] [Let's play.]"),

/* the cups come down */
LN(MO, I_LD_ROLL, -2, 2, 0, "[Shake.|The dice are warm.] [I can hear what yours landed on{A}. Joking. Mostly.|Let's see who lies first.]"),
LN(LY, I_LD_ROLL, -2, 2, 0, "[Shake 'em!|Here we go.] [Best sound in the building, this.|Come on, sixes.]"),
LN(CR, I_LD_ROLL, -2, 2, 0, "[Hm.] [The dice decide. We only guess.]"),
LN(SQ, I_LD_ROLL, -2, 2, 0, "[Ooh, don't look!|No peeking!] [I've got amazing dice. Or terrible ones. Guess!]"),
LN(VX, I_LD_ROLL, -2, 2, 0, "[...]"),
LN(VP, I_LD_ROLL, -2, 2, 0, "[Again.|Roll.] [Let's finish this.]"),
LN(AN, I_LD_ROLL, -2, 2, LF_FEW, "[Not many dice left.|Getting tight.] [Every bid counts now.]"),

/* opening a round */
LN(AN, I_LD_OPEN, -2, 2, 0, "[{q} {f}.|I'll start. {q} {f}.|{q} {f}, to start.]"),
LN(MO, I_LD_OPEN, -2, 2, 0, "[Let's begin.|Mm.] [{q} {f}.]"),
LN(LY, I_LD_OPEN, -2, 2, 0, "[Alright, I'll kick us off.|Openin' bid.] [{q} {f}.]"),
LN(CR, I_LD_OPEN, -2, 2, 0, "[{q} {f}.]"),
LN(SQ, I_LD_OPEN, -2, 2, 0, "[Ooh, me first!|Okay okay okay.] [{q} {f}!]"),
LN(VX, I_LD_OPEN, -2, 2, 0, "[{q} {f}.]"),
LN(VP, I_LD_OPEN, -2, 2, 0, "[I'll set the pace.|Let's not waste time.] [{q} {f}.]"),

/* bidding */
LN(AN, I_LD_BID, -2, 2, 0, "[{q} {f}.|Make it {q} {f}.|{q} {f}, then.]"),
LN(MO, I_LD_BID, -2, 2, 0, "[{q} {f}.|Mm. {q} {f}.|{q}... {f}.]"),
LN(MO, I_LD_BID, -2, 2, LF_JUMP, "[{q} {f}.] [Keep up{A}.|Does that frighten you?]"),
LN(MO, I_LD_BID, -2, 2, T_YOU, "[{q} {f}.] [Your move{A}. I already know what it is.|Go on. Call me a liar. I dare you.]"),
LN(LY, I_LD_BID, -2, 2, 0, "[{q} {f}.|Call it {q} {f}.|I'll say {q} {f}.]"),
LN(LY, I_LD_BID, -2, 2, LF_JUMP, "[Let's make it interestin'.|Raise ya.] [{q} {f}!]"),
LN(LY, I_LD_BID, -2, 2, LF_ONES, "[Goin' to ones.|Ones!] [{q} of 'em.]"),
LN(LY, I_LD_BID, -2, 2, T_CR, "[Sorry, big fella.] [{q} {f}.]"),
LN(CR, I_LD_BID, -2, 2, 0, "[{q} {f}.|Hm. {q} {f}.]"),
LN(CR, I_LD_BID, -2, 2, LF_JUMP, "[{q} {f}.] [Yes.]"),
LN(SQ, I_LD_BID, -2, 2, 0, "[{q} {f}!|Ooh, {q} {f}.|Let's say... {q} {f}!]"),
LN(SQ, I_LD_BID, -2, 2, LF_JUMP, "[Big one!|Hold onto your cups!] [{q} {f}!]"),
LN(SQ, I_LD_BID, -2, 2, T_VP, "[(in Viper's voice) {q} {f}, brother.|{q} {f}. Kneel, peasants. Ha!]"),
LN(VX, I_LD_BID, -2, 2, 0, "[{q} {f}.|{q}. {f}.]"),
LN(VP, I_LD_BID, -2, 2, 0, "[{q} {f}.|Raise. {q} {f}.]"),
LN(VP, I_LD_BID, -2, 2, LF_JUMP, "[{q} {f}.] [Keep up or get out.|Scared yet?]"),
LN(VP, I_LD_BID, -2, 2, T_MO, "[{q} {f}.] [Read that, old man.]"),
LN(AN, I_LD_BID, -2, 2, LF_PALI, "[Palifico. {q} {f}.|Same face. {q} {f}.]"),

/* the tells. Small habits, not shouting. They slip out when bluffing, and sometimes when not */
LN(MO, I_LD_TELL, -2, 2, 0, "[...|Mm.|(tilts his head)|Interesting.]"),
LN(LY, I_LD_TELL, -2, 2, 0, "[I reckon.|Reckon so.|Or so I reckon.]"),
LN(CR, I_LD_TELL, -2, 2, 0, "[Hm. Hm.|...Yes. Yes.]"),
LN(SQ, I_LD_TELL, -2, 2, 0, "[No, really.|Honestly.|For real this time.]"),
LN(VX, I_LD_TELL, -2, 2, 0, "[That's my bid.|That's the bid.]"),
LN(VP, I_LD_TELL, -2, 2, 0, "[Obviously.|Of course.|Naturally.]"),

/* what they say about YOUR bid */
LN(AN, I_LD_PBID, -2, 2, LF_HIGH, "[{q} {f}{A}? Really?|That many {f}?|Bold.] [Hm.|I wonder.]"),
LN(AN, I_LD_PBID, -2, 2, LF_SAFE, "[{q} {f}. Safe.|Playing it safe{A}.] [Fair enough.]"),
LN(MO, I_LD_PBID, -2, 2, LF_HIGH, "[{q} {f}.] [Your hand twitched when you said that{A}.|Your pulse says otherwise.|I heard that. Did you mean it?]"),
LN(MO, I_LD_PBID, -2, 2, LF_SLOW, "[You took a long time over that{A}.|All that thinking.] [People think hard when they lie.]"),
LN(MO, I_LD_PBID, -2, 2, LF_FAST, "[So quick{A}.|No hesitation.] [Either you have them, or you practised.]"),
LN(LY, I_LD_PBID, -2, 2, LF_HIGH, "[Whoa, {q} {f}?|Big talk, partner.] [You sure about that?]"),
LN(LY, I_LD_PBID, -2, 2, LF_JUMP, "[Jumpin' up, huh?|Somebody's feelin' lucky.]"),
LN(LY, I_LD_PBID, -2, 2, LF_SLOW, "[Took your sweet time{A}.] [Somethin' you ain't tellin' us?]"),
LN(CR, I_LD_PBID, -2, 2, LF_HIGH, "[Hm.] [That is a lot of {f}{A}.]"),
LN(SQ, I_LD_PBID, -2, 2, LF_HIGH, "[Ooh, {q} {f}! Liar! Maybe! I don't know!|That's a lot of {f}!] [I'm watching your face. It's a nice face.]"),
LN(SQ, I_LD_PBID, -2, 2, LF_ONES, "[Ones! Fancy!] [Very brave.]"),
LN(VX, I_LD_PBID, -2, 2, LF_HIGH, "[Hm.]"),
LN(VX, I_LD_PBID, -2, 2, LF_SLOW, "[You hesitated.]"),
LN(VP, I_LD_PBID, -2, 2, LF_HIGH, "[{q} {f}?] [From you? I doubt it.|Cute.]"),
LN(VP, I_LD_PBID, -2, 2, LF_LIAR, "[Another bid from our liar.|You bluffed last time, brother.] [I remember.]"),
LN(AN, I_LD_PBID, -2, 2, LF_LIAR, "[You lied last time{A}.|After the last round?] [I'm watching you.]"),

/* calling liar */
LN(AN, I_LD_CALL, -2, 2, 0, "[Liar.|Liar!|I don't believe you, {tgt}.]"),
LN(MO, I_LD_CALL, -2, 2, 0, "[Liar.|No, {tgt}.] [I saw that lie before you said it.|Lift the cups.]"),
LN(MO, I_LD_CALL, -2, 2, T_YOU, "[Liar{A}.|No.] [Your mind told me everything.|I heard you lying from across the room.]"),
LN(MO, I_LD_CALL, -2, 2, T_VP, "[Liar, Viper.] [You never could lie to me.]"),
LN(LY, I_LD_CALL, -2, 2, 0, "[Liar!|Nope. Liar!|Hold it right there. Liar!] [Show me, {tgt}.|Lift 'em up.]"),
LN(LY, I_LD_CALL, -2, 2, LF_REVENGE, "[Payback time, {tgt}.|Remember last round?] [Liar!]"),
LN(CR, I_LD_CALL, -2, 2, 0, "[Liar.|No.] [Show me, {tgt}.]"),
LN(SQ, I_LD_CALL, -2, 2, 0, "[LIAR! Probably!|Liar liar!|Ooh, I call it! Liar!] [Pants on fire, {tgt}!|Show us!]"),
LN(VX, I_LD_CALL, -2, 2, 0, "[Liar.|No.]"),
LN(VP, I_LD_CALL, -2, 2, 0, "[Liar.|Enough, {tgt}. Liar.] [Lift it.|Show me what you've got. Which is nothing.]"),
LN(VP, I_LD_CALL, -2, 2, T_MO, "[Liar, old man.] [Read THAT.]"),
LN(AN, I_LD_CALL, -2, 2, LF_LIAR, "[You've lied before, {tgt}.|Not again, {tgt}.] [Liar.]"),
LN(AN, I_LD_SPOT, -2, 2, 0, "[Spot on.|That's exactly right.|Spot on, {tgt}.]"),
LN(MO, I_LD_SPOT, -2, 2, 0, "[Spot on.] [Exactly {q}. I can see them.]"),
LN(VX, I_LD_SPOT, -2, 2, 0, "[Spot on.] [Exactly.]"),
LN(SQ, I_LD_SPOT, -2, 2, 0, "[Spot on! I've always wanted to say that!|Exactly right! Spot on!]"),

/* the one being called */
LN(AN, I_LD_CALLED, -2, 2, 0, "[Go ahead. Look.|Lift 'em.|Check.]"),
LN(MO, I_LD_CALLED, -2, 2, 0, "[Brave{A}.|Mm.] [Let's see who's right.|Lift them.]"),
LN(LY, I_LD_CALLED, -2, 2, 0, "[Oh, you're callin' ME?|Alright, alright.] [Let's see 'em.]"),
LN(LY, I_LD_CALLED, -2, 2, LF_BLUFF, "[Now hold on, let's not be hasty...|Aw, c'mon.] [...Fine.]"),
LN(CR, I_LD_CALLED, -2, 2, 0, "[Hm.] [Look.]"),
LN(SQ, I_LD_CALLED, -2, 2, 0, "[Me? A liar? Never!|How dare you! ...Okay, lift them.]"),
LN(SQ, I_LD_CALLED, -2, 2, LF_BLUFF, "[Wait, wait, can I change my bid? No? Okay.|Hm. Hmm. Hmmm.]"),
LN(VX, I_LD_CALLED, -2, 2, 0, "[Look.]"),
LN(VP, I_LD_CALLED, -2, 2, 0, "[You'll regret that, {tgt}.|Bad mistake.] [Lift them.]"),
LN(VP, I_LD_CALLED, -2, 2, LF_BLUFF, "[...Fine.|Whatever.] [Lift them.]"),

/* caught bluffing (the bidder lost) */
LN(AN, I_LD_CAUGHT, -2, 2, 0, "[Ah.|Damn.|Fair enough.] [You got me.|Caught.]"),
LN(MO, I_LD_CAUGHT, -2, 2, 0, "[...Hm.|Well.] [I let you catch that one{A}.|A test. You passed.|The dice lied. Not me.]"),
LN(MO, I_LD_CAUGHT, -2, -1, 0, "[Impossible.|That's...] [Nobody catches ME.|Enjoy that, {tgt}. It won't happen again.]"),
LN(LY, I_LD_CAUGHT, -2, 2, 0, "[Aw, shucks.|Dang it.|Well, you got me.] [Worth a try.|Can't win 'em all.]"),
LN(LY, I_LD_CAUGHT, -2, 2, LF_CLOSE, "[One short!|Missed by one!] [Dang it, so close.]"),
LN(CR, I_LD_CAUGHT, -2, 2, 0, "[Hm.] [You are right.|A mistake.]"),
LN(SQ, I_LD_CAUGHT, -2, 2, 0, "[Okay, okay, I lied!|Busted!|Oops.] [In my defence, I'm a liar.|It was my evil twin.]"),
LN(VX, I_LD_CAUGHT, -2, 2, 0, "[Tch.|Fine.]"),
LN(VP, I_LD_CAUGHT, -2, 2, 0, "[Lucky call, {tgt}.|Tch.] [Don't get used to it.|That was a test.]"),
LN(VP, I_LD_CAUGHT, -2, -1, 0, "[You... fine!|Enough!] [This isn't over, {tgt}.]"),
LN(AN, I_LD_CAUGHT, -2, 2, LF_WAYOFF, "[Way off.|Not even close.] [Worth a shot.]"),

/* called wrong (the caller lost) */
LN(AN, I_LD_WRONG, -2, 2, 0, "[Ah.|Hm.|Well.] [They were there.|My mistake.]"),
LN(MO, I_LD_WRONG, -2, 2, 0, "[...I knew that.|Hm.] [I wanted to see your face when you won{A}.|A gift. Don't get used to it.]"),
LN(LY, I_LD_WRONG, -2, 2, 0, "[Well I'll be.|Huh.|Aw, c'mon.] [They were really there.|Shoulda kept my mouth shut.]"),
LN(CR, I_LD_WRONG, -2, 2, 0, "[Hm.] [I was wrong. It happens.]"),
LN(SQ, I_LD_WRONG, -2, 2, 0, "[Wait, you were telling the TRUTH?|Who tells the truth at liar's dice?!] [That's cheating!]"),
LN(VX, I_LD_WRONG, -2, 2, 0, "[Hm.|Misread.]"),
LN(VP, I_LD_WRONG, -2, 2, 0, "[Tch.|Whatever.] [Enjoy it while you can, {tgt}.]"),

/* the winner of a challenge rubs it in */
LN(AN, I_LD_GLOAT, -2, 2, 0, "[Told you.|There it is.] [Sorry, {tgt}.|One die down, {tgt}.]"),
LN(MO, I_LD_GLOAT, -2, 2, 0, "[I knew{A}.|Of course.] [I always know.|Did you really think you could lie to ME, {tgt}?]"),
LN(MO, I_LD_GLOAT, -2, 2, T_VP, "[Another lesson, Viper.|Still can't lie to me, Viper.]"),
LN(LY, I_LD_GLOAT, -2, 2, 0, "[Hah!|Yee-haw!|Gotcha, {tgt}!] [Read you like a book.|Hand it over.]"),
LN(LY, I_LD_GLOAT, -2, 2, LF_REVENGE, "[That's for last time, {tgt}.|We're even now.]"),
LN(CR, I_LD_GLOAT, -2, 2, 0, "[Hm.] [Patience, {tgt}.]"),
LN(SQ, I_LD_GLOAT, -2, 2, 0, "[Ha! Yes! I'm a genius!|Did you see that?!] [Sorry {tgt}! Not sorry!]"),
LN(VX, I_LD_GLOAT, -2, 2, 0, "[One down.|Next.]"),
LN(VP, I_LD_GLOAT, -2, 2, 0, "[Pathetic, {tgt}.|Down you go.] [Know your place.|That's how it's done.]"),
LN(VP, I_LD_GLOAT, -2, 2, T_MO, "[Losing your touch, old man?|Not so all-seeing now, are you?]"),

/* someone else's challenge */
LN(AN, I_LD_WATCH, -2, 2, 0, "[Ouch.|Oof.|Called it.] [Poor {tgt}.|Should've seen that coming, {tgt}.]"),
LN(MO, I_LD_WATCH, -2, 2, 0, "[Mm.] [I knew how that would end.|I saw that coming from the first bid.]"),
LN(LY, I_LD_WATCH, -2, 2, 0, "[Whoo!|Ooh, that stung.] [Better you than me, {tgt}.]"),
LN(CR, I_LD_WATCH, -2, 2, 0, "[Hm.] [The dice do not lie. People do.]"),
LN(SQ, I_LD_WATCH, -2, 2, 0, "[Ooh!|Drama!] [I'm doing {tgt}'s face later. That face.]"),
LN(VX, I_LD_WATCH, -2, 2, 0, "[Hm.]"),
LN(VP, I_LD_WATCH, -2, 2, 0, "[Amateurs.|Hmph.]"),
LN(AN, I_LD_WATCH, -2, 2, LF_SAFE, "[Spot on? Really?|Exactly right?!] [Show-off.]"),

/* spot on */
LN(AN, I_LD_SPOTWIN, -2, 2, 0, "[Exactly {cnt}.|Spot on!] [I'll take that die back.]"),
