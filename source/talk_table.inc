LN(MO, I_LD_YOUWIN, -2, 2, 0, "[You won{A}.|Hm.] [I let you. Remember that.|I'll remember this.]"),
LN(LY, I_LD_YOUWIN, -2, 2, 0, "[Well I'll be!|Tip of the hat, partner.] [Fine lyin' tonight.]"),
LN(SQ, I_LD_YOUWIN, -2, 2, 0, "[You won! I'm so proud! I think! Wait, I lost!] [Can I do your victory voice?]"),
LN(VP, I_LD_YOUWIN, -2, 2, 0, "[Beginner's luck.|Enjoy it.] [It won't happen again.]"),

/* waiting on you */
LN(AN, I_LD_WAIT, -2, 2, 0, "[Your bid{A}.|Any time now.|We're waiting.]"),
LN(MO, I_LD_WAIT, -2, 2, 0, "[Take your time{A}.] [The longer you think, the louder your thoughts get.]"),
LN(LY, I_LD_WAIT, -2, 2, 0, "[Tick tock, partner.|Somewhere a clock is tickin'.]"),
LN(SQ, I_LD_WAIT, -2, 2, 0, "[Hellooo?|(yawns) Sorry. That was my Crow impression.]"),
LN(VP, I_LD_WAIT, -2, 2, 0, "[Some of us have a Suite to run.|Today, brother.]"),

