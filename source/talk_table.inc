LN(VX, I_LD_SPOTWIN, -2, 2, 0, "[Exactly.]"),
LN(SQ, I_LD_SPOTWIN, -2, 2, 0, "[EXACTLY! I'm amazing!|Spot on! Somebody write that down!]"),
LN(AN, I_LD_SPOTFAIL, -2, 2, 0, "[{cnt}. Not {q}.|Not quite.] [Worth a try.|Damn.]"),
LN(SQ, I_LD_SPOTFAIL, -2, 2, 0, "[Aw! So close! I think!|Oops. Wrong!]"),
LN(VP, I_LD_SPOTFAIL, -2, 2, 0, "[Tch.] [A calculated risk.]"),

/* down to one die, palifico */
LN(AN, I_LD_PALI, -2, 2, 0, "[One die left.|Down to one.] [Palifico. Same face all round.|No wild ones this round.]"),
LN(MO, I_LD_PALI, -2, 2, LF_LAST, "[One die.] [That's all I need.]"),
LN(LY, I_LD_PALI, -2, 2, LF_LAST, "[One bullet left in the chamber... sorry. One die left.|Last die!] [Make it count.]"),
LN(SQ, I_LD_PALI, -2, 2, LF_LAST, "[One die! Tiny! Precious!] [Don't look at it.]"),
LN(VP, I_LD_PALI, -2, 2, LF_LAST, "[One die.] [Still more than enough.]"),

/* going out */
LN(AN, I_LD_OUT, -2, 2, 0, "[That's me out.|I'm done.] [Good game.]"),
LN(MO, I_LD_OUT, -2, 2, 0, "[...Out.|Hm.] [I let you have this one.|I'll be watching. I'm always watching.]"),
LN(LY, I_LD_OUT, -2, 2, 0, "[Well, that's all she wrote.|I'm out!] [Good game, folks.|I'll get the next round of drinks.]"),
LN(CR, I_LD_OUT, -2, 2, 0, "[I am out.] [Good game.]"),
LN(SQ, I_LD_OUT, -2, 2, 0, "[Nooo! I'm out!|Out already?!] [I'll do commentary! (sports voice) And the tension is unbearable!]"),
LN(VX, I_LD_OUT, -2, 2, 0, "[Out.]"),
LN(VP, I_LD_OUT, -2, 2, 0, "[This game is rigged.|I'm out. Whatever.] [I have a Suite to run.]"),
LN(AN, I_LD_SEEOUT, -2, 2, 0, "[Bye, {tgt}.|And {tgt} is out.] [Better luck next time.]"),
LN(MO, I_LD_SEEOUT, -2, 2, T_VP, "[Goodbye, Viper.] [Back upstairs with you.]"),
LN(VP, I_LD_SEEOUT, -2, 2, T_MO, "[The Moth is out.] [About time someone retired him.]"),
LN(LY, I_LD_SEEOUT, -2, 2, 0, "[So long, {tgt}.|Down goes {tgt}!]"),
LN(SQ, I_LD_SEEOUT, -2, 2, 0, "[Bye {tgt}! I'll play your part from here! (in their voice) Oh no, I'm out.]"),
LN(AN, I_LD_YOUOUT, -2, 2, 0, "[And you're out{A}.|That's you done{A}.] [Stick around. Watch how it's done.|Good try.]"),
LN(MO, I_LD_YOUOUT, -2, 2, 0, "[Out{A}.] [Stay. Watch. You might learn something.]"),
LN(VP, I_LD_YOUOUT, -2, 2, 0, "[Out already{A}?] [The Back Room isn't for everyone.]"),

